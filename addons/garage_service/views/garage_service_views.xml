<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_services" model="ir.actions.act_window">
        <field name="name">Services types</field>
        <field name="path">services</field>
        <field name="res_model">garage.service.type</field>
        <field name="view_mode">list,form</field>
        <field name="help">No services found!</field>
    </record>

    <record id="service_view_list" model="ir.ui.view">
        <field name="name">garage.service.list</field>
        <field name="model">garage.service.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="price"/>
                <field name="duration"/>
            </list>
        </field>
    </record>

        <record id="garage_service_type_view_form" model="ir.ui.view">
        <field name="name">service.type.form</field>
        <field name="model">garage.service.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label class="o_form_label" for="name"/>
                        <h1 class="d-flex">
                            <field name="name"/>
                        </h1>
                    </div>
                        <group>
                            <field name="code"/>
                            <field name="price"/>
                            <field name="duration"/>
                        </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
