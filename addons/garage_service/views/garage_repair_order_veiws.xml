<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_orders" model="ir.actions.act_window">
        <field name="name">Repair orders</field>
<!--        <field name="path">repair-orders</field>-->
        <field name="res_model">garage.repair.order</field>
        <field name="view_mode">list,form</field>
        <field name="help">No orders found!</field>
    </record>

    <record id="order_view_list" model="ir.ui.view">
        <field name="name">repair.order.list</field>
        <field name="model">garage.repair.order</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'in_progress'"
            decoration-success="state == 'done'"
            decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="mechanic_id"/>
                <field name="date_received"/>
                <field name="state"/>
                <field name="amount_total"/>
            </list>
        </field>
    </record>

    <record model="ir.ui.view" id="order_view_form">
        <field name="name">repair.order.form</field>
        <field name="model">garage.repair.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,done"/>
                    <button name="button_in_progress" class="oe_highlight" invisible="state != 'draft'"
                            string="In Progress"
                            type="object" help="Move order to In Progress state"/>
                    <button name="button_done" class="oe_highlight" invisible="state != 'in_progress'" string="Done"
                            type="object" help="Move order to 'Done' state"/>
                    <button name="button_cancel" class="oe_highlight" invisible="state == 'cancelled' or state == 'done'" string="Cancel"
                            type="object" help="Move order to 'Cancelled'"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label class="o_form_label" for="name"/>
                        <h1 class="d-flex">
                            <field name="name"/>
                        </h1>
                    </div>
                    <group string="Technical information">
                        <field name="mechanic_id"/>
                        <field name="date_received"/>
                        <field name="date_delivered"/>
                    </group>
                    <group string="Vehicle information">
                        <field name="owner_id"/>
                        <field name="vehicle_id" string="Vehicle"/>
                        <field name="mileage_in"/>
                        <field name="in_warranty"/>
                    </group>
                    <notebook>
                        <page string="Order Lines" name="order_lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="order_id"/>
                                    <field name="service_type_id"/>
                                    <field name="subtotal"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
