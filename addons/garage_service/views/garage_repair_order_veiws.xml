<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_orders" model="ir.actions.act_window">
        <field name="name">Repair orders</field>
        <field name="path">repair-orders</field>
        <field name="res_model">garage.repair.order</field>
        <field name="view_mode">list,form</field>
        <field name="help">No orders found!</field>
    </record>

    <record id="order_view_list" model="ir.ui.view">
        <field name="name">repair.order.list</field>
        <field name="model">garage.repair.order</field>
        <field name="arch" type="xml">
            <list>
                <field name="id"/>
                <field name="vehicle_id"/>
                <field name="mechanic_id"/>
                <field name="date_received"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record model="ir.ui.view" id="appointment_form_view">
        <field name="name">repair.order.form</field>
        <field name="model">garage.repair.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,done,cancelled"/>
                    <button name="button_in_progress" class="oe_highlight" invisible="state != 'draft'"
                            string="In Progress"
                            type="object" help="Move Appointment to In Progress state"/>
                    <button name="button_cancel" class="oe_highlight" invisible="state != 'in_progress'" string="Cancel"
                            type="object" help="Move Appointment to In Progress state"/>
                </header>
            </form>
        </field>
    </record>
</odoo>
