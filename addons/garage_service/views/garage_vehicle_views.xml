<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_vehicles" model="ir.actions.act_window">
        <field name="name">Vehicles</field>
        <field name="path">vehicles</field>
        <field name="res_model">garage.vehicle</field>
        <field name="view_mode">list,form</field>
        <field name="help">No vehicles found!</field>
    </record>

    <record id="vehicle_view_list" model="ir.ui.view">
        <field name="name">garage.vehicle.list</field>
        <field name="model">garage.vehicle</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="plate"/>
                <field name="owner_id"/>
                <field name="owner_phone"/>
                <field name="repair_count"/>
            </list>
        </field>
    </record>

    <record id="garage_vehicle_view_form" model="ir.ui.view">
        <field name="name">vehicle.form</field>
        <field name="model">garage.vehicle</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label class="o_form_label" for="name"/>
                        <h1 class="d-flex">
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="year"/>
                            <field name="mileage"/>
                            <field name="fuel_type"/>
                        </group>
                        <group>
                            <field name="owner_id"/>
                            <field name="owner_phone"/>
                        </group>
                    </group>

                </sheet>
            </form>
        </field>
    </record>
</odoo>
